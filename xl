#!/usr/bin/env python3
# xl — host-side companion for hackios-begonia.
#
#   xl boot out/boot.img        # fastboot boot the staged image (M1 marker)
#   xl logs                     # attach serial (getty) and dump `pe` output
#   xl pstore                   # pull the ramoops XLDR panic trace from TWRP/adb
#   xl reboot                   # adb reboot into bootloader
#   xl upload-sysroot host      # push build/ artifacts out
#   xl wait-state M1            # poll the UART for a milestone banner
#
# The device    : Redmi Note 8 Pro (`begonia`), UART0 @ 0x11002000 or USB.
# Requirements  : fastboot, adb, pyserial (optional; for `xl logs`).
#
# Milestone banners (docs/milestones.md):
#   M1 "xnuloader on begonia"   M2 "xnu-banner"   M3 "8 cores online"
#   M4 "root:md0 shell"         M5 "launchd up"   M6 "SpringBoard"
import argparse
import os
import subprocess
import sys
import time

MILESTONES = {
    "M1": b"xnuloader on begonia",
    "M2": b"xnu-banner",
    "M3": b"8 cores online",
    "M4": b"root:md0 shell",
    "M5": b"launchd up",
    "M6": b"SpringBoard",
}
PSTORE_MAGIC = b"XLDRPANIC"


def _which(*names):
    for name in names:
        path = subprocess.run(["which", name], capture_output=True) \
            .stdout.decode().strip()
        if path:
            return path
    sys.exit(f"required tool not found: {names}")


def cmd_boot(args):
    fb = _which("fastboot")
    if not os.path.isfile(args.image):
        sys.exit(f"image not found: {args.image}")
    print(f"[xl] {fb} boot {args.image}")
    subprocess.run([fb, "boot", args.image], check=False)
    print("[xl] sent. watch with `xl logs` / `xl pstore` after a warm reset")


def cmd_reboot(args):
    adb = _which("adb")
    subprocess.run([adb, *args.target, "reboot"] +
                   ["bootloader" if args.bootloader else ""],
                   check=False)
    print("[xl] reboot requested")


def cmd_pstore(args, out_dir="uart_capture"):
    """Pull persistent ramoops trace at phys 0x47df0000 (64 KiB) that
    xnuloader stamps with XLDRPANIC; TWRP can `dd` it onto storage."""
    adb = _which("adb")
    os.makedirs(out_dir, exist_ok=True)
    p = os.path.join(out_dir, "ramoops_xldr.bin")
    print(f"[xl] pulling ramoops (XLDRPANIC @ 0x47df0000) → {p}")
    # TWRP/OrangeFox recovery shell exposes /dev/block/by-name/expdb etc.;
    # the ramoops region is a raw pstore address, not a block device, so we
    # dd from the mapped physical frame exposed by the recovery kernel.
    script = ("/dev/null || true")
    subprocess.run([adb, "shell",
                    f"dd if=/dev/pstore/console-ramoops0 of={p} bs=65536 "
                    f"count=1 2>&1 || {script}"], check=False)
    # fallback: pull any pstore records the recovery produced
    subprocess.run([adb, "-e", "pull", "/sys/fs/pstore", out_dir],
                   check=False)
    data = b""
    if os.path.isfile(p):
        with open(p, "rb") as f:
            data = f.read()
    if PSTORE_MAGIC in data:
        off = data.index(PSTORE_MAGIC)
        print("[xl] XLDRPANIC found at offset", off)
        print(data[off:off + 2048].decode(errors="replace"))
    else:
        print("[xl] no XLDRPANIC marker yet (loader never panicked, or "
              "pstore region not pulled — see docs/01_phase1)")


def cmd_logs(args):
    try:
        import serial  # pyserial, optional
    except ImportError:
        print("pyserial not installed: `pip3 install pyserial`")
        cmd_pstore(args)                       # degrade to pstore pull
        return
    port = serial.Serial(args.port, 115200, timeout=1)
    print(f"[xl] streaming {args.port} @115200 — ^C to stop")
    try:
        while True:
            chunk = port.read(1024)
            if chunk:
                sys.stdout.buffer.write(chunk)
                sys.stdout.buffer.flush()
    except KeyboardInterrupt:
        print("\n[xl] closed")


def cmd_wait_state(args):
    try:
        import serial
    except ImportError:
        sys.exit("pyserial not installed: `pip3 install pyserial`")
    needle = MILESTONES.get(args.milestone)
    if needle is None:
        sys.exit(f"unknown milestone {args.milestone}; known: "
                 f"{', '.join(MILESTONES)}")
    port = serial.Serial(args.port, 115200, timeout=1)
    deadline = time.time() + args.timeout
    print(f"[xl] waiting for {args.milestone} banner={needle!r} "
          f"on {args.port} (timeout={args.timeout}s)")
    while time.time() < deadline:
        if needle in port.read(512):
            print(f"[xl] {args.milestone} reached")
            return
    sys.exit(f"[xl] {args.milestone} NOT reached within {args.timeout}s")


def cmd_upload_sysroot(args):
    adb = _which("adb")
    for f in [args.host_dir + "/" + x for x in os.listdir(args.host_dir)]:
        print(f"[xl] push {f}")
        subprocess.run([adb, "push", f, "/cache/"], check=False)


def main():
    ap = argparse.ArgumentParser(prog="xl")
    sub = ap.add_subparsers(dest="cmd", required=True)

    boot = sub.add_parser("boot", help="fastboot boot a staged image")
    boot.add_argument("image", nargs="?", default="out/begonia-boot.img",
                      help="path to boot.img (default: out/begonia-boot.img)")
    boot.set_defaults(func=cmd_boot)

    logs = sub.add_parser("logs", help="stream UART0 serial output")
    logs.add_argument("--port", default="/dev/ttyUSB0")
    logs.set_defaults(func=cmd_logs)

    ps = sub.add_parser("pstore", help="pull ramoops / pstore panic traces")
    ps.set_defaults(func=cmd_pstore)

    rb = sub.add_parser("reboot", help="adb reboot (optionally to bootloader)")
    rb.add_argument("--bootloader", action="store_true")
    rb.set_defaults(func=cmd_reboot)

    wait = sub.add_parser("wait-state", help="wait for a milestone banner")
    wait.add_argument("milestone", choices=list(MILESTONES))
    wait.add_argument("--port", default="/dev/ttyUSB0")
    wait.add_argument("--timeout", type=int, default=180)
    wait.set_defaults(func=cmd_wait_state)

    up = sub.add_parser("upload-sysroot", help="push build/ artifacts to device")
    up.add_argument("host_dir")
    up.set_defaults(func=cmd_upload_sysroot)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
